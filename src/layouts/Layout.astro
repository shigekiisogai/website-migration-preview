---
import '../styles/site.css';
import {siteHeader,navigationItems as menu} from '../lib/navigation.mjs';
import {withBase} from '../lib/paths.mjs';
const {title, lang='en',route='/',source,scriptsAllowed=false}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src ${scriptsAllowed?"'self'":"'none'"}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'`} />
  <slot name="head" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="stylesheet" href={withBase('/site-header.css',base)} />
  <title>{title} – Shigeki ISOGAI</title>
 </head>
 <body>
  <a class="skip-link" href="#content">Skip to content / 本文へ</a>
  <div class="site">
   <Fragment set:html={siteHeader(base,route)} />
   <main id="content" class:list={['site-content',{'home-page':route==='/', 'materials-page':route.startsWith('/teaching/applied-micro/')}]}>
    <article class="content-area"><slot name="before-title" /><h1 class="entry-title">{title}</h1><div class="entry-content"><slot /></div></article>
   </main>
   <footer class="site-footer">
    <nav aria-label="Footer navigation"><ul>{menu.map(p=><li><a href={withBase(p.route,base)}>{p.label}</a></li>)}</ul></nav>
    <p><a href={withBase('/',base)}>Shigeki ISOGAI</a> <span aria-hidden="true">/</span> <span>Migration preview / 移行試作</span>{source&&<> <span aria-hidden="true">/</span> <a href={source}>Original page / 元ページ</a></>}</p>
   </footer>
  </div>
 </body>
</html>
