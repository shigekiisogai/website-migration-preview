---
import Layout from '../layouts/Layout.astro';
import {renderContent} from '../lib/render.mjs';
import redirects from '../lib/redirects.json';
import {withBase} from '../lib/paths.mjs';
export async function getStaticPaths(){
 const pages=import.meta.glob('../content/pages/*.md',{eager:true});
 const entries=Object.values(pages).map((page:any)=>({params:{slug:page.frontmatter.route.replace(/^\//,'').replace(/\/$/,'')||undefined},props:{page}}));
 return [...entries,...Object.entries(redirects).map(([from,to])=>({params:{slug:from.slice(1,-1)},props:{redirect:to}}))];
}
const {page,redirect}=Astro.props;
const target=redirect?withBase(redirect,import.meta.env.BASE_URL):undefined;
const html=page?renderContent(await page.compiledContent(),import.meta.env.BASE_URL):'';
---
{redirect ? <html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow, noarchive" /><meta http-equiv="refresh" content={`0; url=${target}`} /><link rel="canonical" href={target} /><title>Page moved</title></head><body><p><a href={target}>Continue / 移動先へ</a></p></body></html> : <Layout {...page.frontmatter}><Fragment set:html={html} /></Layout>}
